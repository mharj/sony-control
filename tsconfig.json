{
  "compilerOptions": {
    "module": "esnext",
    "target": "es6",
    "lib": ["dom", "es6"],
    "rootDir": ".",
    "outDir": "./dist",
    "moduleResolution": "bundler",
    "sourceRoot": "./src",
    "types": ["node"],
    "declaration": true,
    "removeComments": false,
    "inlineSources": true,
    "inlineSourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "noUnusedLocals": true
  },
  "include": ["src", "test"],
  "exclude": ["dist", "node_modules"]
}
