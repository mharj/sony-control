{
  "compilerOptions": {
    "module": "commonjs",
    "target": "es6",
    "lib": ["dom", "es6"],
    "rootDir": "./src",
    "outDir": "./dist",
    "moduleResolution": "node",
    "sourceRoot": "./src",
    "types": ["node"],
    "declaration": true,
    "removeComments": false,
    "inlineSources": true,
    "inlineSourceMap": true,
    "forceConsistentCasingInFileNames": true,
    "noImplicitReturns": true,
    "noImplicitThis": true,
    "noImplicitAny": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "noUnusedLocals": true
  },
  "include": ["src/*"],
  "exclude": ["test/*", "dist/*", "node_modules/*", "vitest.config.mts"]
}
